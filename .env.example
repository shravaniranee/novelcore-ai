# ==============================================================================
# NovelCore AI - Environment Configuration Example
# ==============================================================================
# Copy this file to `.env.local` for local development.
# Do NOT commit sensitive keys or credentials to git.
# ==============================================================================

# Local PostgreSQL + pgvector Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_local_dev_password
POSTGRES_DB=novelcore
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# Prisma Connection URL (compatible with PostgreSQL + pgvector)
DATABASE_URL="postgresql://postgres:postgres_local_dev_password@localhost:5432/novelcore?schema=public"

# Supabase Authentication Configuration
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"
# SERVER-SIDE ONLY - NEVER EXPOSE TO BROWSER CLIENT CODE
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# GROQ AI LLM Infrastructure Configuration (SERVER-SIDE ONLY)
# Never expose GROQ_API_KEY to browser client code
GROQ_API_KEY="gsk_your_groq_api_key_here"
GROQ_MODEL="groq/compound-mini"

# Embedding Infrastructure Configuration (SERVER-SIDE ONLY)
# Never expose OPENAI_API_KEY to browser client code
EMBEDDING_PROVIDER="openai"
EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_DIM=1536
OPENAI_API_KEY="sk-your-openai-api-key-here"

# Demo Mode Configuration
DEMO_MODE=true
