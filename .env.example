# ==============================================================================
# NovelCore AI - Environment Configuration Example
# ==============================================================================
# Copy this file to `.env` / `.env.local` for local development.
# For Vercel: set these in Project Settings → Environment Variables.
# Do NOT commit real secrets to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# Database (Neon production / local Docker)
# ------------------------------------------------------------------------------
# Local Docker example:
# DATABASE_URL="postgresql://postgres:postgres_local_dev_password@localhost:5432/novelcore?schema=public"
# DIRECT_URL="postgresql://postgres:postgres_local_dev_password@localhost:5432/novelcore?schema=public"

# Neon (recommended for Vercel):
# - DATABASE_URL  = pooled connection string (ends with -pooler....neon.tech) + ?sslmode=require
# - DIRECT_URL    = non-pooled / direct connection string + ?sslmode=require
# Prisma uses DATABASE_URL at runtime and DIRECT_URL for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/novelcore?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/novelcore?sslmode=require"

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_local_dev_password
POSTGRES_DB=novelcore
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# ------------------------------------------------------------------------------
# Supabase Auth (optional but needed for hosted login/signup)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"
# SERVER-SIDE ONLY - NEVER use NEXT_PUBLIC_ prefix
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# ------------------------------------------------------------------------------
# Groq (SERVER-SIDE ONLY) — optional; deterministic fallback works without it
# ------------------------------------------------------------------------------
GROQ_API_KEY="gsk_your_groq_api_key_here"
GROQ_MODEL="openai/gpt-oss-20b"

# ------------------------------------------------------------------------------
# OpenAI embeddings (SERVER-SIDE ONLY) — optional in DEMO_MODE
# ------------------------------------------------------------------------------
EMBEDDING_PROVIDER="openai"
EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_DIM=1536
OPENAI_API_KEY="sk-your-openai-api-key-here"

# ------------------------------------------------------------------------------
# Demo Mode — keep true for first Vercel deploy
# ------------------------------------------------------------------------------
DEMO_MODE=true
