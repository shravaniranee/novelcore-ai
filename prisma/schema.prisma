// ==============================================================================
// NovelCore AI - Production Relational & Vector Database Schema
// ==============================================================================
// Provider: PostgreSQL + pgvector
// Features: Multi-Tenancy (Organizations), Multi-Version Claims, Historical
// Analysis Runs, Prior Art Vector Embeddings, AI Examiner Reviews, and Reports.
// ==============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// ------------------------------------------------------------------------------
// ENUMS
// ------------------------------------------------------------------------------

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
}

enum InventionStatus {
  DRAFT
  ANALYZING
  ANALYZED
  PATENT_READY
  ARCHIVED
}

enum AnalysisStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ImpactLevel {
  HIGH
  MEDIUM
  LOW
}

enum ClaimType {
  INDEPENDENT
  DEPENDENT
}

enum ClaimStatus {
  DRAFT
  OPTIMIZED
  ACCEPTED
  REJECTED
}

enum ObjectionCategory {
  NOVELTY_102
  OBVIOUSNESS_103
  ENABLEMENT_112
  DEFINITENESS_112
  OTHER
}

enum ExaminerReviewStatus {
  PENDING
  COMPLETED
  FAILED
}

enum ExaminerFindingType {
  POTENTIAL_ANTICIPATION
  POTENTIAL_OBVIOUSNESS
  POTENTIAL_SUPPORT_CONCERN
  EVIDENCE_INSUFFICIENT
  NO_MATERIAL_CONCERN
}

enum ReportStatus {
  DRAFT
  GENERATING
  READY
  COMPLETED
  FAILED
}

enum OverlapStatus {
  DISCLOSED
  PARTIAL
  NOT_DISCLOSED
  INSUFFICIENT_EVIDENCE
}

enum GapType {
  CROWDED
  MODERATELY_EXPLORED
  PARTIALLY_EXPLORED
  UNDERSERVED
  POTENTIALLY_DISTINCTIVE
}

// ------------------------------------------------------------------------------
// CORE MODELS
// ------------------------------------------------------------------------------

model HealthCheck {
  id        String   @id @default(uuid())
  status    String   @default("ok")
  createdAt DateTime @default(now())
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  avatarUrl String?
  password  String?  // Secure bcrypt password hash for local credential auth
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships OrganizationMember[]
  inventions  Invention[]
  reports     Report[]

  @@map("users")
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members    OrganizationMember[]
  inventions Invention[]

  @@map("organizations")
}

model OrganizationMember {
  id             String       @id @default(uuid())
  organizationId String
  userId         String
  role           OrgRole      @default(MEMBER)
  createdAt      DateTime     @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@map("organization_members")
}

model Invention {
  id              String          @id @default(uuid())
  userId          String
  organizationId  String?
  title           String
  problem         String          @db.Text
  solution        String          @db.Text
  howItWorks      String          @db.Text
  advantages      String          @db.Text
  differentiation String          @db.Text
  domain          String
  industry        String
  status          InventionStatus @default(DRAFT)
  
  // Vector embedding column & model tracking metadata
  embedding       Unsupported("vector(1536)")?
  embeddingModel  String?
  embeddingDim    Int?

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  analysisRuns    AnalysisRun[]
  claims          Claim[]
  examinerReviews ExaminerReview[]
  reports         Report[]
  opportunities   AnalysisOpportunity[]
  featureOverlapEntries FeatureOverlapMatrixEntry[]
  inventionFeatures     InventionFeature[]

  @@index([userId])
  @@index([organizationId])
  @@index([status])
  @@index([domain])
  @@map("inventions")
}

model AnalysisRun {
  id                      String          @id @default(uuid())
  inventionId             String
  status                  AnalysisStatus  @default(QUEUED)
  currentStep             Int             @default(0)
  noveltyScore            Int?
  patentabilityScore      Int?
  priorArtRisk            RiskLevel?
  industrialApplicability ImpactLevel?
  understanding           String?         @db.Text
  concepts                String[]        @default([])
  ipcCodes                String[]        @default([])
  error                   String?         @db.Text
  createdAt               DateTime        @default(now())
  completedAt             DateTime?

  invention Invention @relation(fields: [inventionId], references: [id], onDelete: Cascade)

  priorArtMatches PriorArtMatch[]
  opportunities   AnalysisOpportunity[]
  reports         Report[]
  featureOverlapEntries FeatureOverlapMatrixEntry[]
  inventionFeatures     InventionFeature[]
  noveltyAssessment     NoveltyAssessment?
  claims                Claim[]
  claimVersions         ClaimVersion[]
  examinerReviews       ExaminerReview[]
  analysisMode          String?         @default("DETERMINISTIC_FALLBACK")

  @@index([inventionId])
  @@index([status])
  @@index([createdAt])
  @@map("analysis_runs")
}

model PriorArtDocument {
  id                String    @id @default(uuid())
  externalId        String?
  publicationNumber String    @unique
  title             String
  abstract          String    @db.Text
  claimsText        String?   @db.Text
  description       String?   @db.Text
  source            String    // USPTO, EPO, GooglePatents, ArXiv, DEMO
  jurisdiction      String    @default("US")
  filingDate        DateTime?
  publicationDate   DateTime?
  priorityDate      DateTime?
  ipcCodes          String[]  @default([])
  cpcCodes          String[]  @default([])
  inventors         String[]  @default([])
  applicants        String[]  @default([])
  assignees         String[]  @default([])
  sourceUrl         String?
  metadata          Json?     @default("{}")

  // Vector embedding column using pgvector (1536 dimensions for vector similarity search)
  embedding         Unsupported("vector(1536)")?
  embeddingModel    String?
  embeddingDim      Int?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  matches PriorArtMatch[]
  featureOverlapEntries FeatureOverlapMatrixEntry[]
  noveltyReferenceAssessments NoveltyReferenceAssessment[]

  @@index([source])
  @@index([jurisdiction])
  @@index([externalId])
  @@map("prior_art_documents")
}

model PriorArtMatch {
  id               String   @id @default(uuid())
  analysisRunId    String
  priorArtDocId    String
  similarityScore  Float    // 0.0 - 1.0 or percentage
  overlap          String[] @default([])
  matchedConcepts  String[] @default([])
  technologyDomain String?
  explanation      String?  @db.Text
  ranking          Int      @default(1)
  createdAt        DateTime @default(now())

  analysisRun AnalysisRun      @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)
  document    PriorArtDocument @relation(fields: [priorArtDocId], references: [id], onDelete: Cascade)

  @@unique([analysisRunId, priorArtDocId])
  @@index([analysisRunId])
  @@index([priorArtDocId])
  @@index([similarityScore])
  @@map("prior_art_matches")
}

model Claim {
  id                String      @id @default(uuid())
  inventionId       String
  analysisRunId     String?
  claimNumber       Int
  claimType         ClaimType   @default(INDEPENDENT)
  parentClaimNumber Int?
  title             String?
  status            ClaimStatus @default(DRAFT)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  invention   Invention    @relation(fields: [inventionId], references: [id], onDelete: Cascade)
  analysisRun AnalysisRun? @relation(fields: [analysisRunId], references: [id], onDelete: SetNull)
  versions    ClaimVersion[]

  @@unique([inventionId, claimNumber])
  @@index([inventionId])
  @@index([analysisRunId])
  @@map("claims")
}

model ClaimVersion {
  id                         String   @id @default(uuid())
  claimId                    String
  analysisRunId              String?
  versionNumber              Int
  claimText                  String   @db.Text
  isOriginal                 Boolean  @default(false)
  isOptimized                Boolean  @default(false)
  source                     String   @default("AI_ASSISTED")
  model                      String?
  optimizationReason         String?
  groundedFeatureRatio       Float    @default(1.0)
  featureCount               Int      @default(0)
  groundedFeatureCount       Int      @default(0)
  singleReferenceCoverage    Float    @default(0.0)
  collectivePriorArtCoverage Float    @default(0.0)
  evidenceConfidence         Float    @default(0.0)
  differentiationScore       Int      @default(50)
  vulnerabilityIndicator     String   @default("LOW")
  vulnerabilityScore         Int      @default(0)
  vulnerabilityDetails       Json?
  priorArtVulnerabilities    Json?
  limitations                String?
  riskReduction              String?
  differentiationNotes       String?  @db.Text
  elementOverlapAnalysis     Json?    @default("[]")
  createdAt                  DateTime @default(now())

  claim       Claim          @relation(fields: [claimId], references: [id], onDelete: Cascade)
  analysisRun AnalysisRun?   @relation(fields: [analysisRunId], references: [id], onDelete: SetNull)
  elements    ClaimElement[]

  @@unique([claimId, versionNumber])
  @@index([claimId])
  @@index([analysisRunId])
  @@map("claim_versions")
}

model ClaimElement {
  id                 String    @id @default(uuid())
  claimVersionId     String
  inventionFeatureId String?
  featureKey         String
  elementKey         String
  text               String    @db.Text
  order              Int
  elementType        String    @default("LIMITATION")
  createdAt          DateTime  @default(now())

  claimVersion     ClaimVersion      @relation(fields: [claimVersionId], references: [id], onDelete: Cascade)
  inventionFeature InventionFeature? @relation(fields: [inventionFeatureId], references: [id], onDelete: SetNull)

  @@unique([claimVersionId, elementKey])
  @@index([claimVersionId])
  @@index([inventionFeatureId])
  @@index([featureKey])
  @@map("claim_elements")
}

model ExaminerReview {
  id                String               @id @default(uuid())
  analysisRunId     String?
  inventionId       String
  claimId           String?
  claimVersionId    String?
  status            ExaminerReviewStatus @default(COMPLETED)
  overallRisk       RiskLevel            @default(MEDIUM)
  confidence        Float                @default(0.0)
  claimReviews      Json?                @default("[]")

  // Legacy fields for backward compatibility
  objectionCategory ObjectionCategory?   @default(OTHER)
  severity          RiskLevel?           @default(MEDIUM)
  title             String?              @default("Examiner Simulation Review")
  concern           String?              @db.Text
  evidence          String?              @db.Text
  recommendation    String?              @db.Text
  isResolved        Boolean              @default(false)
  resolvedAt        DateTime?

  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  invention   Invention         @relation(fields: [inventionId], references: [id], onDelete: Cascade)
  analysisRun AnalysisRun?      @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)
  findings    ExaminerFinding[]

  @@index([inventionId])
  @@index([analysisRunId])
  @@index([status])
  @@index([isResolved])
  @@index([severity])
  @@map("examiner_reviews")
}

model ExaminerFinding {
  id                    String              @id @default(uuid())
  examinerReviewId      String
  findingType           ExaminerFindingType
  severity              RiskLevel           @default(MEDIUM)
  title                 String
  explanation           String              @db.Text
  confidence            Float               @default(0.0)
  claimNumber           Int
  claimVersionNumber    Int
  claimElementKeys      String[]            @default([])
  priorArtDocumentIds   String[]            @default([])
  supportingFeatureKeys String[]            @default([])
  evidence              Json                @default("[]")
  recommendation        String              @db.Text
  provenance            String              @default("DETERMINISTIC") // 'DETERMINISTIC' | 'GROQ_ASSISTED'
  createdAt             DateTime            @default(now())

  examinerReview ExaminerReview @relation(fields: [examinerReviewId], references: [id], onDelete: Cascade)

  @@index([examinerReviewId])
  @@index([findingType])
  @@index([claimNumber])
  @@map("examiner_findings")
}

model Report {
  id                    String       @id @default(uuid())
  inventionId           String
  analysisRunId         String       @unique
  userId                String
  title                 String
  status                ReportStatus @default(GENERATING)
  reportVersion         Int          @default(1)
  executiveSummary      String?      @db.Text
  overallAssessment     String?      @db.Text
  finalRecommendation   String?
  recommendationReason  String?      @db.Text
  sectionsSnapshot      Json?        @default("{}")
  evidenceSources       Json?        @default("[]")
  provenance            String       @default("DETERMINISTIC") // 'DETERMINISTIC' | 'GROQ_ASSISTED'
  disclaimer            String?      @db.Text
  fileUrl               String?
  fileKey               String?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  invention   Invention        @relation(fields: [inventionId], references: [id], onDelete: Cascade)
  analysisRun AnalysisRun      @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  evidence    ReportEvidence[]

  @@index([inventionId])
  @@index([userId])
  @@index([status])
  @@map("reports")
}

/// Relational evidence traceability for unified reports (Phase 11).
/// Validated structured sections live in Report.sectionsSnapshot (Zod-validated snapshot)
/// to avoid unnecessary ReportSection table complexity while preserving queryable evidence rows.
model ReportEvidence {
  id                String   @id @default(uuid())
  reportId          String
  sectionKey        String
  sourceType        String
  sourceId          String
  featureKey        String?
  publicationNumber String?
  claimNumber       Int?
  elementKey        String?
  description       String?  @db.Text
  createdAt         DateTime @default(now())

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, sectionKey, sourceType, sourceId])
  @@index([reportId])
  @@index([sourceType])
  @@index([sourceId])
  @@map("report_evidence")
}

model AnalysisOpportunity {
  id                    String      @id @default(uuid())
  inventionId           String
  analysisRunId         String?
  opportunityKey        String?
  gapType               GapType     @default(MODERATELY_EXPLORED)
  title                 String
  impact                ImpactLevel @default(MEDIUM)
  whyItMatters          String      @db.Text
  expectedImpact        String      @db.Text
  recommendedAction     String      @db.Text
  relatedFeatureKeys    String[]    @default([])
  supportingPriorArtIds String[]    @default([])
  coverage              Float       @default(0.0)
  confidence            Float       @default(0.0)
  differentiationScore  Int         @default(50)
  evidenceDetails       Json?
  limitations           String?     @db.Text
  explanation           String?     @db.Text
  explanationProvenance String?
  applied               Boolean     @default(false)
  appliedAt             DateTime?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @default(now()) @updatedAt

  invention   Invention    @relation(fields: [inventionId], references: [id], onDelete: Cascade)
  analysisRun AnalysisRun? @relation(fields: [analysisRunId], references: [id], onDelete: SetNull)

  @@unique([analysisRunId, opportunityKey])
  @@index([inventionId])
  @@index([analysisRunId])
  @@index([gapType])
  @@index([applied])
  @@map("analysis_opportunities")
}

model FeatureOverlapMatrixEntry {
  id                 String        @id @default(uuid())
  inventionId        String
  analysisRunId      String
  priorArtDocumentId String
  featureId          String
  overlapStatus      OverlapStatus
  evidence           String        @db.Text
  evidenceSource     String?       // title, abstract, claims, description
  featureName        String?
  featureDescription String?       @db.Text
  explanation        String?       @db.Text
  featureRecordId    String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  invention        Invention         @relation(fields: [inventionId], references: [id], onDelete: Cascade)
  analysisRun      AnalysisRun       @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)
  priorArtDocument PriorArtDocument  @relation(fields: [priorArtDocumentId], references: [id], onDelete: Cascade)
  featureRecord    InventionFeature? @relation(fields: [featureRecordId], references: [id], onDelete: SetNull)

  @@unique([analysisRunId, priorArtDocumentId, featureId])
  @@index([inventionId])
  @@index([analysisRunId])
  @@index([priorArtDocumentId])
  @@index([featureId])
  @@index([featureRecordId])
  @@index([overlapStatus])
  @@map("feature_overlap_matrix_entries")
}

model InventionFeature {
  id            String    @id @default(uuid())
  analysisRunId String
  inventionId   String
  featureKey    String    // e.g. "F1", "F2"
  name          String
  description   String    @db.Text
  order         Int       @default(0)
  source        String?   // 'ai_extracted' | 'user_defined' | 'fallback'
  isNovelty     Boolean   @default(false)
  createdAt     DateTime  @default(now())

  analysisRun   AnalysisRun @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)
  invention     Invention   @relation(fields: [inventionId], references: [id], onDelete: Cascade)
  matrixEntries FeatureOverlapMatrixEntry[]
  claimElements ClaimElement[]

  @@unique([analysisRunId, featureKey])
  @@index([inventionId])
  @@index([analysisRunId])
  @@map("invention_features")
}

model NoveltyAssessment {
  id                   String                       @id @default(uuid())
  analysisRunId        String                       @unique
  noveltyScore         Int                          // 0 - 100
  noveltyBand          String                       // HIGH_NOVELTY, MODERATE_NOVELTY, LOW_NOVELTY, INSUFFICIENT_EVIDENCE
  evidenceConfidence  Float                        // 0.0 - 1.0
  singleReferenceRisk  String                       // LOW, MODERATE, HIGH, CRITICAL
  collectiveCoverage   Float                        // 0.0 - 1.0
  patentabilityRisk    RiskLevel                    @default(MEDIUM)
  scoringBreakdown     Json                         @default("{}")
  evidenceReferences   Json                         @default("[]")
  groqExplanation      String?                      @db.Text
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt

  analysisRun          AnalysisRun                  @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)
  referenceAssessments NoveltyReferenceAssessment[]

  @@index([analysisRunId])
  @@index([noveltyBand])
  @@map("novelty_assessments")
}

model NoveltyReferenceAssessment {
  id                        String            @id @default(uuid())
  noveltyAssessmentId       String
  priorArtDocumentId        String
  disclosedFeatureCount     Int               @default(0)
  partialFeatureCount       Int               @default(0)
  notDisclosedFeatureCount  Int               @default(0)
  insufficientEvidenceCount Int               @default(0)
  coverageRatio             Float             @default(0.0)
  evidenceConfidence        Float             @default(0.0)
  anticipationRisk          String            // LOW, MODERATE, HIGH, CRITICAL
  evidenceDetails           Json              @default("[]")
  createdAt                 DateTime          @default(now())

  noveltyAssessment         NoveltyAssessment @relation(fields: [noveltyAssessmentId], references: [id], onDelete: Cascade)
  priorArtDocument          PriorArtDocument  @relation(fields: [priorArtDocumentId], references: [id], onDelete: Cascade)

  @@unique([noveltyAssessmentId, priorArtDocumentId])
  @@index([noveltyAssessmentId])
  @@index([priorArtDocumentId])
  @@map("novelty_reference_assessments")
}
